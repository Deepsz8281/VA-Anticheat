<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.vaplus</groupId>
    <artifactId>vaplus-anticheat</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>VAPlus</name>
    <description>Prediction-based anticheat for Paper, Purpur and Folia (Minecraft 1.21 and newer, including 26.x)</description>

    <properties>
        <!--
            Bytecode targets Java 21 so the same jar loads on 1.21.x servers (Java 21) and on
            26.x servers (Java 25+). We compile against the oldest supported API so nothing newer
            than 1.21.1 leaks into the code base; version-specific features go through PacketEvents
            or the compat layer.
        -->
        <java.release>21</java.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <paper.api.version>1.21.1-R0.1-SNAPSHOT</paper.api.version>
        <packetevents.version>2.14.0</packetevents.version>
        <junit.version>5.11.4</junit.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>codemc-releases</id>
            <url>https://repo.codemc.io/repository/maven-releases/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.api.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- Provided by the PacketEvents plugin at runtime (declared as hard dependency in plugin.yml). -->
        <dependency>
            <groupId>com.github.retrooper</groupId>
            <artifactId>packetevents-spigot</artifactId>
            <version>${packetevents.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>VAPlus-${project.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>plugin.yml</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${java.release}</release>
                    <compilerArgs>
                        <arg>-Xlint:all,-processing,-serial</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <!-- PacketEvents 2.14 item mappings need Adventure 4.26.1 at test runtime.
                         Keep compilation on Paper 1.21.1's API; no added jars are packaged. -->
                    <classpathDependencyExcludes>
                        <classpathDependencyExclude>net.kyori:adventure-api</classpathDependencyExclude>
                        <classpathDependencyExclude>net.kyori:adventure-key</classpathDependencyExclude>
                        <classpathDependencyExclude>net.kyori:adventure-nbt</classpathDependencyExclude>
                    </classpathDependencyExcludes>
                    <additionalClasspathDependencies>
                        <additionalClasspathDependency>
                            <groupId>net.kyori</groupId>
                            <artifactId>adventure-api</artifactId>
                            <version>4.26.1</version>
                        </additionalClasspathDependency>
                        <additionalClasspathDependency>
                            <groupId>net.kyori</groupId>
                            <artifactId>adventure-nbt</artifactId>
                            <version>4.26.1</version>
                        </additionalClasspathDependency>
                    </additionalClasspathDependencies>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>
        </plugins>
    </build>
</project>
